---
const benefits = [
  {
    eyebrow: 'Verified agents', title: 'Every agent is vetted',
    body: 'Licences, reviews and past trips are checked before an agent can take a booking.',
    glyph: 'ring',
  },
  {
    eyebrow: 'Offline ready', title: 'Your plan works without signal',
    body: 'Itineraries, tickets and maps stay on your phone once a trip is saved.',
    glyph: 'diamond',
  },
  {
    eyebrow: 'Clear pricing', title: 'One total, no surprises',
    body: 'Stays, transport and activities are quoted as a single figure before you commit.',
    glyph: 'bars',
  },
  {
    eyebrow: 'Local knowledge', title: 'Written by people who live there',
    body: 'Guides come from residents and returning travellers, not scraped listings.',
    glyph: 'square',
  },
  {
    eyebrow: 'Anytime support', title: 'Someone answers mid-trip',
    body: 'In-app chat reaches a human, and your agent stays reachable for the whole journey.',
    glyph: 'arc',
  },
  {
    eyebrow: 'Your data', title: 'Location stays yours',
    body: 'Geo-aware discovery runs on request. Nothing is sold on, and you can switch it off.',
    glyph: 'dot',
  },
];
---
<section class="benefits">
  <div class="container">
    <div class="head" data-reveal>
      <div class="eyebrow">Other benefits</div>
      <h2>More reasons to travel with Ọ̀nà.</h2>
    </div>
    <div class="grid" data-reveal>
      {benefits.map((b) => (
        <div class="card">
          <div class="glyph-wrap"><span class:list={['glyph', b.glyph]}></span></div>
          <div class="tag">{b.eyebrow}</div>
          <h3>{b.title}</h3>
          <p>{b.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .benefits { background: var(--paper); padding: clamp(72px, 8vw, 110px) 24px; }
  .head { max-width: 620px; margin-bottom: clamp(40px, 5vw, 64px); }
  .eyebrow { font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--green); margin-bottom: 16px; }
  h2 {
    font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 4vw, 48px);
    line-height: 1.05; letter-spacing: -.025em; color: var(--forest); text-wrap: balance;
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(18px, 2.4vw, 28px); }
  .card { background: #fff; border: 1px solid var(--border-sand); border-radius: 20px; padding: 28px 26px 30px; }
  .glyph-wrap {
    width: 38px; height: 38px; border-radius: 11px; background: var(--sand);
    display: flex; align-items: center; justify-content: center; margin-bottom: 20px;
  }
  .glyph.ring { width: 12px; height: 12px; border: 3px solid var(--green); border-radius: 99px; display: block; }
  .glyph.diamond { width: 14px; height: 14px; background: var(--gold); border-radius: 3px; display: block; transform: rotate(45deg); }
  .glyph.bars { width: 16px; height: 3px; background: var(--green); border-radius: 2px; display: block; box-shadow: 0 5px 0 var(--green), 0 -5px 0 var(--gold); }
  .glyph.square { width: 14px; height: 14px; border: 3px solid var(--gold); border-radius: 3px; display: block; }
  .glyph.arc { width: 16px; height: 16px; border-radius: 99px; border: 3px solid var(--green); border-top-color: var(--gold); display: block; }
  .glyph.dot { width: 14px; height: 14px; background: var(--green); border-radius: 99px; display: block; box-shadow: inset 0 0 0 3px var(--sand); }
  .tag { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #16171A; opacity: .55; margin-bottom: 8px; }
  h3 { font-family: var(--font-display); font-size: 20px; font-weight: 600; color: var(--forest); margin: 0 0 10px; line-height: 1.25; }
  p { font-size: 15px; line-height: 1.6; color: #16171A; opacity: .7; }
</style>
