---
import QRCode from './QRCode.astro';
---
<section id="get" class="cta">
  <div class="inner container" data-reveal>
    <div class="copy">
      <h2>Your next trip starts with one tap.</h2>
      <p>Ona is free to download. The adventure isn't optional.</p>
      <div class="store-buttons">
        <a href="#get" class="store">
          <svg width="20" height="24" viewBox="0 0 24 28" fill="#EDE1CB"><path d="M17.2 14.8c0-3 2.4-4.4 2.5-4.5-1.4-2-3.5-2.3-4.2-2.3-1.8-.2-3.4 1-4.3 1-.9 0-2.3-1-3.7-1-1.9 0-3.7 1.1-4.6 2.9-2 3.4-.5 8.5 1.4 11.3.9 1.4 2 2.9 3.5 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.5-1.4 3.4-2.7.6-1 1.1-2 1.4-2.9-2.6-1-3-3.5-3-4.6zM14.7 5.6c.8-1 1.3-2.3 1.2-3.6-1.2 0-2.6.8-3.4 1.7-.7.8-1.3 2.2-1.2 3.4 1.3.1 2.6-.6 3.4-1.5z"></path></svg>
          <div><div class="eyebrow">Download on the</div><div class="name">App Store</div></div>
        </a>
        <a href="#get" class="store">
          <svg width="20" height="22" viewBox="0 0 22 24" fill="none"><path d="M2.6 1.6 14 12 2.6 22.4c-.4-.3-.6-.8-.6-1.4V3c0-.6.2-1.1.6-1.4z" fill="#EDE1CB"></path><path d="M14 12l3.6-3.3 2.9 1.7c1 .6 1 2.6 0 3.2l-2.9 1.7L14 12z" fill="#D99B36"></path><path d="M2.6 1.6 14 12l3.6-3.3L4.6.9c-.7-.4-1.5-.2-2 .7zM2.6 22.4 14 12l3.6 3.3L4.6 23.1c-.7.4-1.5.2-2-.7z" fill="#EDE1CB" opacity=".72"></path></svg>
          <div><div class="eyebrow">Get it on</div><div class="name">Google Play</div></div>
        </a>
      </div>
    </div>
    <div class="codes">
      <div class="codes-label">Scan to install</div>
      <div class="codes-grid">
        <div class="code-col">
          <QRCode variant="ios" size={150} />
          <div>
            <div class="platform">iPhone</div>
            <div class="store-name">App Store</div>
          </div>
        </div>
        <div class="code-col">
          <QRCode variant="android" size={150} />
          <div>
            <div class="platform">Android</div>
            <div class="store-name">Google Play</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--gold); padding: clamp(64px, 7vw, 96px) 24px; }
  .inner { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(32px, 5vw, 64px); }
  .copy { flex: 1 1 340px; min-width: 0; }
  h2 {
    font-family: var(--font-display); font-weight: 700; font-size: clamp(32px, 4.6vw, 58px);
    line-height: 1.02; letter-spacing: -.03em; color: var(--forest); margin: 0 0 18px; text-wrap: balance;
  }
  .copy p { font-size: 18px; line-height: 1.55; color: var(--forest); opacity: .8; margin: 0 0 32px; max-width: 26em; }
  .store-buttons { display: flex; flex-wrap: wrap; gap: 12px; }
  .store { display: flex; align-items: center; gap: 11px; background: var(--forest); border-radius: 14px; padding: 13px 22px; }
  .store:hover { background: #16171A; }
  .eyebrow { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--sand); opacity: .65; }
  .name { font-family: var(--font-display); font-size: 17px; font-weight: 600; color: var(--paper); }

  .codes { flex: 0 1 340px; min-width: 0; }
  .codes-label { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--forest); margin-bottom: 14px; }
  .codes-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; }
  .code-col { display: flex; flex-direction: column; gap: 10px; }
  .platform { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--forest); }
  .store-name { font-family: var(--font-display); font-size: 15px; font-weight: 600; color: var(--forest); }
</style>
