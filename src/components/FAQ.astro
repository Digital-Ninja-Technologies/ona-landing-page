---
const faqs = [
  ['Is Ọ̀nà free?', 'Downloading and planning is free. You only pay when you book a stay, an activity or an agent-built trip.'],
  ['How does the AI build an itinerary?', 'You give it a destination, dates and a budget. It drafts a day-by-day plan from local guides and live availability, and you can edit any day before saving.'],
  ['Can I work with a real person instead?', 'Yes. Browse verified local agents, see their past trips and rates, then hand over the whole plan or just one leg of it.'],
  ['Which countries are covered?', 'Ọ̀nà launches across Nigeria, Ghana and Kenya, with agent coverage expanding city by city. Anywhere else, AI planning still works.'],
  ['How do I sign in?', 'Apple, Google or email. Pick a username and you are exploring in seconds.'],
  ['What happens if a trip changes?', 'Rebooking runs through the same chat thread as your original plan, so your agent or support can move things without starting over.'],
];
---
<section id="faq" class="faq">
  <div class="container inner">
    <div class="intro" data-reveal>
      <div class="eyebrow">FAQ</div>
      <h2>Questions, answered.</h2>
      <p>Still stuck? Reach us in the app or at hello@ona.travel.</p>
    </div>
    <div class="list" data-reveal>
      {faqs.map(([q, a], i) => (
        <details class="item" name="faq" open={i === 0}>
          <summary>
            <span class="q">{q}</span>
            <span class="sign" aria-hidden="true"></span>
          </summary>
          <p class="a">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--sand); padding: clamp(72px, 8vw, 110px) 24px; }
  .inner { display: flex; flex-wrap: wrap; gap: clamp(32px, 5vw, 72px); align-items: flex-start; }
  .intro { flex: 1 1 280px; min-width: 0; }
  .eyebrow { font-size: 13px; letter-spacing: .18em; text-transform: uppercase; color: var(--green); margin-bottom: 16px; }
  h2 {
    font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 4vw, 48px);
    line-height: 1.05; letter-spacing: -.025em; color: var(--forest); margin: 0 0 16px; text-wrap: balance;
  }
  .intro p { font-size: 16px; line-height: 1.6; color: #16171A; opacity: .7; }

  .list { flex: 1.3 1 420px; min-width: 0; }
  .item { border-bottom: 1px solid var(--border-sand); }
  summary {
    list-style: none;
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 22px 0; cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  .q {
    font-family: var(--font-display); font-size: clamp(16px, 1.4vw, 19px); font-weight: 600;
    color: var(--forest); line-height: 1.3;
  }
  .sign {
    width: 30px; height: 30px; flex: 0 0 auto; border-radius: 99px; background: var(--paper);
    border: 1px solid var(--border-sand); color: var(--green); font-family: var(--font-display);
    font-size: 17px; font-weight: 600; display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .sign::before, .sign::after {
    content: ''; position: absolute; background: currentColor; border-radius: 1px;
  }
  .sign::before { width: 11px; height: 2px; }
  .sign::after { width: 2px; height: 11px; transition: transform .15s ease; }
  details[open] .sign::after { transform: scaleY(0); }
  .a { font-size: 16px; line-height: 1.65; color: #16171A; opacity: .75; margin: 0 0 24px; max-width: 46em; }
</style>
