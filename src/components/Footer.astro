---
import LogoMark from './LogoMark.astro';
---
<footer class="footer">
  <div class="container">
    <div class="top">
      <LogoMark width={132} height={54} />
      <div class="stores">
        <a href="#get" class="store-link">
          <svg width="17" height="20" viewBox="0 0 24 28" fill="#EDE1CB"><path d="M17.2 14.8c0-3 2.4-4.4 2.5-4.5-1.4-2-3.5-2.3-4.2-2.3-1.8-.2-3.4 1-4.3 1-.9 0-2.3-1-3.7-1-1.9 0-3.7 1.1-4.6 2.9-2 3.4-.5 8.5 1.4 11.3.9 1.4 2 2.9 3.5 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.5-1.4 3.4-2.7.6-1 1.1-2 1.4-2.9-2.6-1-3-3.5-3-4.6zM14.7 5.6c.8-1 1.3-2.3 1.2-3.6-1.2 0-2.6.8-3.4 1.7-.7.8-1.3 2.2-1.2 3.4 1.3.1 2.6-.6 3.4-1.5z"></path></svg>
          <span>App Store</span>
        </a>
        <a href="#get" class="store-link">
          <svg width="17" height="19" viewBox="0 0 22 24" fill="none"><path d="M2.6 1.6 14 12 2.6 22.4c-.4-.3-.6-.8-.6-1.4V3c0-.6.2-1.1.6-1.4z" fill="#EDE1CB"></path><path d="M14 12l3.6-3.3 2.9 1.7c1 .6 1 2.6 0 3.2l-2.9 1.7L14 12z" fill="#D99B36"></path><path d="M2.6 1.6 14 12l3.6-3.3L4.6.9c-.7-.4-1.5-.2-2 .7zM2.6 22.4 14 12l3.6 3.3L4.6 23.1c-.7.4-1.5.2-2-.7z" fill="#EDE1CB" opacity=".72"></path></svg>
          <span>Google Play</span>
        </a>
      </div>
    </div>
    <div class="bottom">
      <div class="tagline">Ọ̀nà — the way, the path, the journey. Find yours.</div>
      <div class="copyright">© 2026 Ona</div>
    </div>
  </div>
</footer>

<style>
  .footer { background: #16171A; padding: clamp(48px, 6vw, 72px) 24px 40px; }
  .top {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px;
    padding-bottom: 36px; border-bottom: 1px solid rgba(237, 225, 203, .14);
  }
  .stores { display: flex; flex-wrap: wrap; gap: 12px; }
  .store-link {
    display: flex; align-items: center; gap: 10px; border: 1px solid rgba(237, 225, 203, .22);
    border-radius: 12px; padding: 10px 18px;
  }
  .store-link:hover { border-color: var(--gold); }
  .store-link span { font-family: var(--font-display); font-size: 14px; font-weight: 500; color: var(--sand); }
  .bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; padding-top: 26px; }
  .tagline { font-size: 15px; color: var(--sand); opacity: .7; font-weight: 300; }
  .copyright { font-size: 13px; color: var(--sand); opacity: .4; }
</style>
