---
import { Image } from 'astro:assets';
import PhoneFrame from './PhoneFrame.astro';
import PhoneStatusBar from './PhoneStatusBar.astro';
import PhoneTabBar from './PhoneTabBar.astro';
import LogoMark from './LogoMark.astro';
import lekki from '../assets/hero/lekki-conservation.webp';
import nike from '../assets/hero/nike-art-gallery.webp';
import idanre from '../assets/hero/idanre-hills.webp';

const places = [
  { img: lekki, name: 'Lekki Conservation', desc: 'Canopy walkway above the wetlands, 20 min from Victoria Island.' },
  { img: nike, name: 'Nike Art Gallery', desc: 'Five floors of Nigerian art, free to walk through.' },
  { img: idanre, name: 'Idanre Hills', desc: '667 steps up to a hill town older than most maps.' },
];
---
<section id="top" class="hero">
  <div class="hero-bg" aria-hidden="true">
    <svg width="100%" height="100%" viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" fill="none">
      <path d="M-40 700C220 640 180 420 420 380 660 340 700 140 980 120" stroke="#1B5E4B" stroke-width="2" stroke-dasharray="10 14"></path>
      <path d="M-40 820C260 780 300 560 540 520 780 480 860 300 1240 280" stroke="#1B5E4B" stroke-width="2" stroke-dasharray="10 14"></path>
      <circle cx="420" cy="380" r="5" fill="#D99B36"></circle>
      <circle cx="980" cy="120" r="5" fill="#D99B36"></circle>
    </svg>
  </div>

  <div class="hero-inner container">
    <div class="hero-copy" data-reveal>
      <div class="eyebrow">
        <span class="dot"></span>
        <span>Ọ̀nà — the way, in your pocket</span>
      </div>
      <h1>
        <span>Find your way.</span>
        <span class="accent">Then get lost in it.</span>
      </h1>
      <p class="lede">Ona is the all-in-one travel companion that plans your trip, connects you with local experts, and keeps you company the whole way there.</p>
      <div class="store-badges">
        <div class="badge">
          <svg width="20" height="24" viewBox="0 0 24 28" fill="#EDE1CB"><path d="M17.2 14.8c0-3 2.4-4.4 2.5-4.5-1.4-2-3.5-2.3-4.2-2.3-1.8-.2-3.4 1-4.3 1-.9 0-2.3-1-3.7-1-1.9 0-3.7 1.1-4.6 2.9-2 3.4-.5 8.5 1.4 11.3.9 1.4 2 2.9 3.5 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.5-1.4 3.4-2.7.6-1 1.1-2 1.4-2.9-2.6-1-3-3.5-3-4.6zM14.7 5.6c.8-1 1.3-2.3 1.2-3.6-1.2 0-2.6.8-3.4 1.7-.7.8-1.3 2.2-1.2 3.4 1.3.1 2.6-.6 3.4-1.5z"></path></svg>
          <div><div class="badge-eyebrow">Download on the</div><div class="badge-name">App Store</div></div>
        </div>
        <div class="badge">
          <svg width="20" height="22" viewBox="0 0 22 24" fill="none"><path d="M2.6 1.6 14 12 2.6 22.4c-.4-.3-.6-.8-.6-1.4V3c0-.6.2-1.1.6-1.4z" fill="#EDE1CB"></path><path d="M14 12l3.6-3.3 2.9 1.7c1 .6 1 2.6 0 3.2l-2.9 1.7L14 12z" fill="#D99B36"></path><path d="M2.6 1.6 14 12l3.6-3.3L4.6.9c-.7-.4-1.5-.2-2 .7zM2.6 22.4 14 12l3.6 3.3L4.6 23.1c-.7.4-1.5.2-2-.7z" fill="#EDE1CB" opacity=".72"></path></svg>
          <div><div class="badge-eyebrow">Get it on</div><div class="badge-name">Google Play</div></div>
        </div>
      </div>
    </div>

    <div class="hero-phone-slot">
      <div class="hero-phone-rise">
        <PhoneFrame size="hero">
          <PhoneStatusBar size="hero" />
          <div class="screen-body">
            <div class="screen-top">
              <LogoMark width={74} height={30} ring="#123A2C" text="#123A2C" />
              <div class="screen-icons">
                <span class="bell">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#16171A" stroke-width="1.8" stroke-linecap="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 01-3.4 0"></path></svg>
                  <span class="ping-dot"></span>
                  <span class="ping-ring"></span>
                </span>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#16171A" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M16.6 16.6L21 21"></path></svg>
              </div>
            </div>
            <div class="welcome">Welcome to Ọ̀nà (Way Finder)</div>
            <div class="subwelcome">Dear Tola, where are you exploring today?</div>
            <div class="popular-head">
              <div class="popular-title">Popular Near Lagos</div>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6E6A5E" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="7"></circle><circle cx="12" cy="12" r="2.2" fill="#6E6A5E" stroke="none"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg>
            </div>
            <div class="carousel-mask">
              <div data-marquee class="carousel-track">
                {places.map((p) => (
                  <div class="place-card">
                    <div class="place-photo">
                      <Image src={p.img} alt={p.name} width={264} height={198} loading="eager" />
                    </div>
                    <div class="place-copy">
                      <div class="place-name">{p.name}</div>
                      <div class="place-desc">{p.desc}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="explore-label">Input your location to explore</div>
            <div class="explore-input-row">
              <div class="explore-input">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6E6A5E" stroke-width="1.8" stroke-linecap="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1116 0z"></path><circle cx="12" cy="10" r="2.6"></circle></svg>
                <span class="placeholder-text">Or type any location...</span>
                <span class="caret"></span>
              </div>
              <div class="explore-go">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F5F0E6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 6l6 6-6 6"></path></svg>
              </div>
            </div>
          </div>
          <div class="fab">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#16171A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.7 4.6L18.3 9.3l-4.6 1.7L12 15.6l-1.7-4.6L5.7 9.3l4.6-1.7z"></path><path d="M18 16l.8 2.2L21 19l-2.2.8L18 22l-.8-2.2L15 19l2.2-.8z"></path></svg>
          </div>
          <PhoneTabBar active="explore" />
        </PhoneFrame>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--forest);
    position: relative;
    overflow: hidden;
    padding: 66px 24px 0;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    opacity: .5;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
    padding: 56px 0 0;
  }
  .hero-copy {
    /* Grows to fill whatever the (capped-width) phone column doesn't need,
       so the headline gets real room instead of splitting growth with a
       column whose content is already capped at 380px. */
    flex: 1 1 420px;
    min-width: 0;
    padding-top: 60px;
    padding-bottom: 105px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(237, 225, 203, .28);
    border-radius: 999px;
    padding: 7px 16px 7px 12px;
    margin-bottom: 26px;
  }
  .eyebrow .dot { width: 7px; height: 7px; border-radius: 99px; background: var(--gold); }
  .eyebrow span:last-child {
    font-size: 13px;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--sand);
    opacity: .9;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 6.4vw, 76px);
    line-height: .98;
    letter-spacing: -.03em;
    color: var(--paper);
    margin: 0 0 22px;
    text-wrap: balance;
  }
  /* Below 480px the two-phrase layout can't guarantee both nowrap lines
     fit even at the font-size floor, so let the browser wrap naturally
     there instead of clipping off-screen. From 480px up, the column is
     wide enough at the current font-size floor to lock each phrase to
     its own line. */
  h1 span { display: block; overflow-wrap: break-word; }
  @media (min-width: 480px) {
    h1 span { white-space: nowrap; }
  }
  h1 .accent { color: var(--gold); }
  .lede {
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--sand);
    opacity: .82;
    max-width: 33em;
    margin: 0 0 34px;
    font-weight: 300;
    text-wrap: pretty;
  }
  .store-badges { display: flex; gap: 12px; flex-wrap: wrap; }
  .badge {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(237, 225, 203, .3);
    border-radius: 14px;
    padding: 10px 18px;
    transition: transform .2s cubic-bezier(.2,.8,.2,1), border-color .2s, background .2s;
  }
  .badge:hover {
    transform: translateY(-3px);
    border-color: var(--gold);
    background: rgba(237, 225, 203, .06);
  }
  .badge-eyebrow { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--sand); opacity: .6; }
  .badge-name { font-family: var(--font-display); font-size: 16px; font-weight: 600; color: var(--sand); }

  .hero-phone-slot {
    /* No grow: the phone inside is already capped at max-width:380px, so
       letting this column grow just wastes width the headline needs. */
    flex: 0 1 340px;
    display: flex;
    justify-content: center;
    align-self: flex-end;
    min-width: 0;
    overflow: hidden;
  }
  .hero-phone-rise {
    width: 100%;
    max-width: 380px;
    animation: onaRise 1.1s cubic-bezier(.16,.84,.24,1) both;
    margin-bottom: -282px;
  }

  .screen-body { flex: 1; overflow: hidden; padding: 8px 16px 0; }
  .screen-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .screen-icons { display: flex; align-items: center; gap: 12px; }
  .bell { position: relative; display: flex; }
  .ping-dot, .ping-ring {
    position: absolute; right: -1px; top: -1px; width: 7px; height: 7px; border-radius: 9px; background: var(--gold);
  }
  .ping-ring { animation: onaPing 2.2s ease-out infinite; }

  .welcome {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: #16171A;
    line-height: 1.15;
    animation: onaIn .7s cubic-bezier(.2,.8,.2,1) .5s both;
  }
  .subwelcome {
    font-size: 11px;
    color: var(--muted);
    margin: 4px 0 16px;
    animation: onaIn .7s cubic-bezier(.2,.8,.2,1) .62s both;
  }
  .popular-head {
    display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 9px;
    animation: onaIn .7s cubic-bezier(.2,.8,.2,1) .74s both;
  }
  .popular-title { font-family: var(--font-display); font-size: 13px; font-weight: 600; color: #16171A; }

  .carousel-mask {
    overflow: hidden;
    margin-bottom: 16px;
    animation: onaIn .8s cubic-bezier(.2,.8,.2,1) .86s both;
  }
  .carousel-track {
    display: flex;
    gap: 10px;
    width: max-content;
    animation: onaSlide 15s linear infinite;
  }
  .place-card {
    width: 132px;
    flex: 0 0 auto;
    background: var(--sand);
    border-radius: 14px;
    overflow: hidden;
  }
  .place-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--green);
  }
  .place-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .place-copy { padding: 9px 10px 11px; }
  .place-name { font-family: var(--font-display); font-size: 12px; font-weight: 600; color: #16171A; }
  .place-desc { font-size: 9.5px; color: var(--muted); line-height: 1.35; margin-top: 2px; }

  .explore-label {
    font-family: var(--font-display); font-size: 13px; font-weight: 600; color: #16171A; margin-bottom: 9px;
    animation: onaIn .7s cubic-bezier(.2,.8,.2,1) .98s both;
  }
  .explore-input-row {
    display: flex; align-items: center; gap: 8px;
    animation: onaIn .7s cubic-bezier(.2,.8,.2,1) 1.1s both;
  }
  .explore-input {
    flex: 1; display: flex; align-items: center; gap: 8px; background: var(--sand); border-radius: 14px; padding: 11px 13px;
  }
  .placeholder-text { font-size: 11px; color: var(--muted); }
  .caret { width: 1.5px; height: 12px; background: var(--green); border-radius: 1px; animation: onaCaret 1.1s steps(1,end) infinite; }
  .explore-go {
    width: 38px; height: 38px; border-radius: 12px; background: var(--green); display: flex; align-items: center; justify-content: center;
  }

  .fab {
    position: absolute; right: 16px; bottom: 82px; width: 50px; height: 50px; border-radius: 16px; background: var(--gold);
    display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 18px -6px rgba(22,23,26,.5);
    animation: onaIn .6s ease-out 1.25s both, onaPulse 3.4s ease-in-out 1.9s infinite;
  }

  @media (max-width: 760px) {
    .hero-phone-rise { margin-bottom: -220px; }
  }
  @media (max-width: 560px) {
    .hero-phone-rise { margin-bottom: -170px; }
  }
</style>
