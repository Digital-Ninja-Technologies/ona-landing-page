---
import LogoMark from './LogoMark.astro';
---
<nav class="nav">
  <div class="nav-inner container">
    <a href="#top" aria-label="Ọ̀nà home">
      <LogoMark width={122} height={50} />
    </a>
    <div class="nav-links">
      <a href="#features">Features</a>
      <a href="#how">How it works</a>
      <a href="#faq">FAQ</a>
      <button type="button" class="nav-download" data-open-download>Download</button>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    background: rgba(18, 58, 44, .94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(237, 225, 203, .12);
    padding: 11px 24px;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .nav-links a {
    font-size: 15px;
    color: var(--sand);
    opacity: .85;
  }
  .nav-links a:hover {
    color: var(--gold);
    opacity: 1;
  }
  .nav-download {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--forest);
    background: var(--sand);
    padding: 11px 20px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: background .2s, transform .2s cubic-bezier(.2,.8,.2,1);
  }
  .nav-download:hover { background: var(--gold); transform: translateY(-2px); }
  .nav-download:active { transform: translateY(0); }
</style>
