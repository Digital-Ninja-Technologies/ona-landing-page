---
import LogoMark from './LogoMark.astro';
---
<nav class="nav">
  <div class="nav-inner container">
    <a href="#top" class="nav-logo" aria-label="Ọ̀nà home">
      <LogoMark width={122} height={50} />
    </a>

    <div class="nav-links" id="nav-links">
      <a href="#features">Features</a>
      <a href="#how">How it works</a>
      <a href="#faq">FAQ</a>
      <button type="button" class="nav-download" data-open-download>Download</button>
    </div>

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label="Toggle menu"
    >
      <svg class="icon-burger" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EDE1CB" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EDE1CB" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    background: rgba(18, 58, 44, .94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(237, 225, 203, .12);
    padding: 11px 24px;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .nav-logo { flex: 0 0 auto; line-height: 0; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .nav-links a {
    font-size: 15px;
    color: var(--sand);
    opacity: .85;
  }
  .nav-links a:hover {
    color: var(--gold);
    opacity: 1;
  }

  .nav-download {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--forest);
    background: var(--sand);
    padding: 11px 20px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: background .2s, transform .2s cubic-bezier(.2,.8,.2,1);
    white-space: nowrap;
  }
  .nav-download:hover { background: var(--gold); transform: translateY(-2px); }
  .nav-download:active { transform: translateY(0); }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    border: 1px solid rgba(237, 225, 203, .28);
    border-radius: 10px;
    background: transparent;
    cursor: pointer;
  }
  .nav-toggle .icon-close { display: none; }
  .nav-toggle[aria-expanded="true"] .icon-burger { display: none; }
  .nav-toggle[aria-expanded="true"] .icon-close { display: block; }

  /* Below this width the link row (including the Download capsule) moves
     into a dropdown panel opened by .nav-toggle, so the top row always
     stays a single line: logo, hamburger. */
  @media (max-width: 760px) {
    .nav-inner { gap: 10px; }
    .nav-toggle { display: flex; }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: rgba(18, 58, 44, .98);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(237, 225, 203, .12);
      padding: 4px 24px 18px;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity .18s ease, transform .18s ease;
    }
    .nav-links.is-open {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .nav-links a {
      padding: 13px 0;
      border-top: 1px solid rgba(237, 225, 203, .1);
      opacity: .9;
    }
    /* The Download capsule sits inside the panel too, set apart from the
       plain links as the row's one filled, full-width action. */
    .nav-links .nav-download {
      margin-top: 14px;
      width: 100%;
      text-align: center;
      padding: 13px 20px;
    }
  }
</style>
