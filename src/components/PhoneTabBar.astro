---
type Tab = 'explore' | 'agents' | 'itineraries' | 'messages' | 'community' | 'profile';

interface Props {
  active: Tab;
}

const { active } = Astro.props;

const icons: Record<Exclude<Tab, 'profile'>, { inactive: string; active: string; label: string }> = {
  explore: {
    label: 'Explore',
    inactive: '<circle cx="12" cy="12" r="9"></circle><path d="M16.2 7.8l-2.1 6.4-6.4 2.1 2.1-6.4z"></path>',
    active: '<path d="M12 2a10 10 0 100 20 10 10 0 000-20zm4.24 5.76l-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z"></path>',
  },
  agents: {
    label: 'Agents',
    inactive: '<path d="M4 14v-2a8 8 0 0116 0v2"></path><path d="M4 14h2v5H5a1 1 0 01-1-1zM20 14h-2v5h1a1 1 0 001-1z"></path><path d="M18 19v1a2 2 0 01-2 2h-3"></path>',
    active: '<path d="M12 3a8 8 0 00-8 8v1h3v6H5a1 1 0 01-1-1v-6a8 8 0 1116 0v6a3 3 0 01-3 3h-4v-2h4a1 1 0 001-1v-6a8 8 0 00-8-8z"></path><path d="M17 12h3v6h-3z"></path>',
  },
  itineraries: {
    label: 'Itineraries',
    inactive: '<path d="M9 4l6 2 6-2v14l-6 2-6-2-6 2V6z"></path><path d="M9 4v14M15 6v14"></path>',
    active: '<path d="M9 3.6L15 5.6 21 3.6v14.8l-6 2-6-2-6 2V5.6z" opacity=".95"></path>',
  },
  messages: {
    label: 'Messages',
    inactive: '<path d="M21 12a8 8 0 01-11.6 7.1L3 21l1.9-6.4A8 8 0 1121 12z"></path>',
    active: '<path d="M21 12a8 8 0 01-11.6 7.1L3 21l1.9-6.4A8 8 0 1121 12z"></path>',
  },
  community: {
    label: 'Community',
    inactive: '<circle cx="9" cy="8" r="3"></circle><circle cx="17" cy="9" r="2.2"></circle><path d="M3 19a6 6 0 0112 0M15 19a4 4 0 016-3.4"></path>',
    active: '<circle cx="9" cy="8" r="3.2"></circle><circle cx="17" cy="9" r="2.4"></circle><path d="M3 19a6 6 0 0112 0zM15.5 19a4.5 4.5 0 015.5-3.8V19z"></path>',
  },
};

const order: Tab[] = ['explore', 'agents', 'itineraries', 'messages', 'community', 'profile'];
---
<nav class="tabbar" aria-label="App navigation (illustrative)">
  {order.map((tab) => {
    if (tab === 'profile') {
      return (
        <div class="tab">
          <div class="avatar">T</div>
          <span class:list={['label', { active: active === 'profile' }]}>Profile</span>
        </div>
      );
    }
    const isActive = active === tab;
    const icon = icons[tab];
    return (
      <div class="tab">
        {isActive ? (
          <svg width="19" height="19" viewBox="0 0 24 24" fill="#16171A" set:html={icon.active} />
        ) : (
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#6E6A5E" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icon.inactive} />
        )}
        <span class:list={['label', { active: isActive }]}>{icon.label}</span>
      </div>
    );
  })}
</nav>

<style>
  .tabbar {
    border-top: 1px solid var(--border-sand);
    background: var(--paper);
    display: flex;
    padding: 8px 4px 14px;
  }
  .tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .avatar {
    width: 19px;
    height: 19px;
    border-radius: 99px;
    background: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: 600;
    color: var(--forest);
  }
  .label {
    font-size: 8.5px;
    color: #6E6A5E;
  }
  .label.active {
    font-weight: 600;
    color: #16171A;
  }
</style>
