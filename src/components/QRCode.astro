---
// Decorative, non-scannable QR-style pattern — a placeholder until real
// App Store / Google Play links exist to encode.
interface Props {
  variant?: 'ios' | 'android';
  size?: number;
  bg?: string;
  border?: boolean;
}

const { variant = 'ios', size = 150, bg = '#F5F0E6', border = false } = Astro.props;

const cellsIOS = [
  { col: '1/3', row: '1/3', r: '5px' },
  { col: '6/8', row: '1/3', r: '5px' },
  { col: '1/3', row: '6/8', r: '5px' },
  { col: '4/5', row: '1/2', r: '3px' },
  { col: '4/6', row: '3/4', r: '3px' },
  { col: '3/4', row: '4/5', r: '3px' },
  { col: '5/6', row: '5/6', r: '3px', accent: true },
  { col: '6/8', row: '6/7', r: '3px' },
  { col: '4/5', row: '7/8', r: '3px' },
  { col: '7/8', row: '4/5', r: '3px' },
];

const cellsAndroid = [
  { col: '1/3', row: '1/3', r: '5px' },
  { col: '6/8', row: '1/3', r: '5px' },
  { col: '1/3', row: '6/8', r: '5px' },
  { col: '3/4', row: '1/2', r: '3px' },
  { col: '5/6', row: '2/3', r: '3px' },
  { col: '3/5', row: '4/5', r: '3px' },
  { col: '6/7', row: '4/6', r: '3px' },
  { col: '4/5', row: '6/7', r: '3px', accent: true },
  { col: '5/7', row: '7/8', r: '3px' },
  { col: '1/2', row: '4/5', r: '3px' },
];

const cells = variant === 'ios' ? cellsIOS : cellsAndroid;
---
<div
  class="qr"
  class:list={{ bordered: border }}
  style={`width:100%; max-width:${size}px; background:${bg};`}
  role="img"
  aria-label={variant === 'ios' ? 'Decorative QR code placeholder for the App Store' : 'Decorative QR code placeholder for Google Play'}
>
  {cells.map((c) => (
    <div
      class:list={['cell', { accent: c.accent }]}
      style={`grid-column:${c.col}; grid-row:${c.row}; border-radius:${c.r};`}
    ></div>
  ))}
</div>

<style>
  .qr {
    aspect-ratio: 1;
    border-radius: 20px;
    padding: 15px;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    grid-template-rows: repeat(7, 1fr);
    gap: 4px;
  }
  .qr.bordered { border: 1px solid var(--border-sand); }
  .cell { background: var(--forest); }
  .cell.accent { background: var(--gold); }
</style>
