---
import WaitlistForm from './WaitlistForm.astro';
---
<section id="waitlist" class="waitlist">
  <div class="container inner" data-reveal>
    <div class="copy">
      <div class="eyebrow">Coming soon</div>
      <h2>Be first in line for Ọ̀nà.</h2>
      <p>We're putting the finishing touches on the app. Drop your email and we'll let you know the moment it's ready to download.</p>
    </div>

    <div class="form-col">
      <WaitlistForm />
    </div>
  </div>
</section>

<style>
  .waitlist { background: var(--forest); padding: clamp(64px, 7vw, 96px) 24px; }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
  }
  .copy { flex: 1 1 380px; min-width: 0; }
  .eyebrow {
    font-size: 13px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.06;
    letter-spacing: -.025em;
    color: var(--paper);
    margin: 0 0 14px;
    text-wrap: balance;
  }
  .copy p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--sand);
    opacity: .78;
    font-weight: 300;
    max-width: 34em;
    margin: 0;
  }
  .form-col { flex: 1 1 380px; min-width: 0; }
</style>
