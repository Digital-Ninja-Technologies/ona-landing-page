---
import PhoneFrame from '../PhoneFrame.astro';
import PhoneStatusBar from '../PhoneStatusBar.astro';

const tools = [
  { name: 'Currency Converter', desc: 'Convert between currencies with live rates', delay: '0s',
    icon: '<circle cx="12" cy="12" r="9"></circle><path d="M14.5 9.3A2.6 2.6 0 0012 8c-1.4 0-2.5.9-2.5 2s1.1 2 2.5 2 2.5.9 2.5 2-1.1 2-2.5 2a2.6 2.6 0 01-2.5-1.3M12 6.5v11"></path>', join: false },
  { name: 'Safety Tips', desc: 'Travel safety advice by category', delay: '.4s',
    icon: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path>', join: true },
  { name: 'Emergency Contacts', desc: 'Police, ambulance, fire, and embassy numbers', delay: '.8s',
    icon: '<path d="M5 3h4l2 5-2.5 1.5a12 12 0 006 6L16 13l5 2v4a2 2 0 01-2 2A16 16 0 013 5a2 2 0 012-2z"></path>', join: true },
  { name: 'Cultural Etiquette', desc: "Do's and don'ts for respectful travel", delay: null,
    icon: '<path d="M4 8l4-4 4 3 4-3 4 4-4 5-4-2-4 2z"></path><path d="M8 13v7h8v-7"></path>', join: false },
  { name: 'Packing Checklist', desc: 'Check off items as you pack', delay: null,
    icon: '<path d="M4 7l2 2 3-3M4 15l2 2 3-3M13 8h7M13 16h7"></path>', join: false },
  { name: 'Visa Requirements', desc: 'Check visa needs for any passport and destination', delay: null,
    icon: '<path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path>', join: true },
];
---
<PhoneFrame size="feature">
  <PhoneStatusBar size="feature" />
  <div class="head">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16171A" stroke-width="2" stroke-linecap="round"><path d="M15 5l-7 7 7 7"></path></svg>
    <div class="title">Travel Essentials</div>
  </div>
  <div class="body">
    <div class="sub">Everything you need to know before and during your trip</div>
    <div class="list">
      {tools.map((t) => (
        <div class="row">
          <div class="icon-wrap" style={t.delay ? `animation:onaBadge 4s ease-in-out ${t.delay} infinite` : ''}>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin={t.join ? 'round' : undefined} set:html={t.icon} />
          </div>
          <div class="info">
            <div class="name">{t.name}</div>
            <div class="desc">{t.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</PhoneFrame>

<style>
  .head { display: flex; align-items: center; gap: 10px; padding: 10px 16px 10px; }
  .title { font-family: var(--font-display); font-size: 15px; font-weight: 600; color: #16171A; }
  .body { flex: 1; overflow: hidden; padding: 4px 16px 0; }
  .sub { font-size: 11px; color: var(--muted); margin-bottom: 14px; }
  .list { display: flex; flex-direction: column; gap: 11px; }
  .row { background: var(--sand); border: 1px solid var(--border-sand); border-radius: 16px; padding: 12px; display: flex; align-items: center; gap: 13px; }
  .icon-wrap { width: 40px; height: 40px; flex: 0 0 auto; border-radius: 99px; background: var(--green); display: flex; align-items: center; justify-content: center; }
  .name { font-family: var(--font-display); font-size: 13px; font-weight: 600; color: #16171A; }
  .desc { font-size: 10.5px; color: var(--muted); margin-top: 2px; }
</style>
