---
import PhoneFrame from '../PhoneFrame.astro';
import PhoneStatusBar from '../PhoneStatusBar.astro';
import PhoneTabBar from '../PhoneTabBar.astro';

const places = [
  { name: 'Nike Art Gallery', desc: 'Five floors of Nigerian art in Lekki. Free entry, guided tours on request.', tone: 'light' },
  { name: 'Lekki Conservation Centre', desc: "Africa's longest canopy walkway, plus a 2h nature trail.", tone: 'dark' },
  { name: 'Ilashe Beach', desc: 'Quiet stretch reached by ferry from Victoria Island.', tone: 'light' },
];
---
<PhoneFrame size="feature">
  <PhoneStatusBar size="feature" />
  <div class="head">
    <div class="title">Attractions in Lagos</div>
    <div class="weather">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#16171A" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      <span>Clear</span>
    </div>
    <div class="loc-row">
      <div class="loc">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6E6A5E" stroke-width="1.8"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1116 0z"></path><circle cx="12" cy="10" r="2.6"></circle></svg>
        <span>Lagos</span>
      </div>
      <div class="go">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F5F0E6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M12 6l6 6-6 6"></path></svg>
      </div>
    </div>
    <div class="chips">
      <span class="chip active">Attractions</span>
      <span class="chip">Hotels</span>
      <span class="chip">Restaurants</span>
    </div>
  </div>
  <div class="body">
    {places.map((p) => (
      <div class="row">
        <div class:list={['thumb', p.tone]}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={p.tone === 'dark' ? '#EDE1CB' : '#123A2C'} stroke-width="1.5" opacity={p.tone === 'dark' ? '.6' : '.45'}><path d="M3 17l5-6 4 4 3-3 6 5"></path><circle cx="8" cy="7" r="2"></circle></svg>
        </div>
        <div class="info">
          <div class="name">{p.name}</div>
          <div class="desc">{p.desc}</div>
        </div>
      </div>
    ))}
    <div class="more">More</div>
  </div>
  <PhoneTabBar active="explore" />
</PhoneFrame>

<style>
  .head { padding: 10px 16px 0; }
  .title { font-family: var(--font-display); font-size: 14px; font-weight: 600; color: #16171A; }
  .weather { display: inline-flex; align-items: center; gap: 5px; background: var(--sand); border-radius: 20px; padding: 5px 11px; margin-top: 9px; font-size: 10.5px; color: #16171A; }
  .loc-row { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
  .loc { flex: 1; display: flex; align-items: center; gap: 8px; background: var(--sand); border-radius: 14px; padding: 10px 12px; font-size: 11px; color: #16171A; }
  .go { width: 34px; height: 34px; border-radius: 11px; background: var(--green); display: flex; align-items: center; justify-content: center; animation: onaBadge 3.8s ease-in-out infinite; }
  .chips { display: flex; gap: 7px; margin-top: 11px; overflow: hidden; }
  .chip { font-size: 10.5px; border-radius: 20px; padding: 5px 12px; white-space: nowrap; color: #16171A; background: var(--sand); }
  .chip.active { color: var(--paper); background: var(--green); }
  .body { flex: 1; overflow: hidden; padding: 14px 16px 0; display: flex; flex-direction: column; gap: 11px; }
  .row { background: var(--sand); border-radius: 14px; padding: 11px; display: flex; gap: 11px; align-items: center; }
  .thumb { width: 60px; height: 60px; flex: 0 0 auto; border-radius: 10px; display: flex; align-items: center; justify-content: center; background: var(--border-sand); }
  .thumb.dark { background: var(--green); }
  .info { min-width: 0; }
  .name { font-family: var(--font-display); font-size: 12.5px; font-weight: 600; color: #16171A; }
  .desc { font-size: 10.5px; color: var(--muted); line-height: 1.4; margin-top: 3px; }
  .more { align-self: center; border: 1px solid var(--border-sand); border-radius: 16px; padding: 8px 22px; font-size: 11px; font-weight: 600; color: #16171A; }
</style>
